# ===========================================
# Vachana Sanchaya - Environment Variables
# ===========================================
# Copy this file to .env and fill in the values.
#   cp .env.example .env
# ===========================================

# ----- Required -----

# Google Gemini API Key (required for AI Agent / RAG assistant)
# Get one at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ----- Optional -----

NODE_ENV=development
PORT=3001

# RAG / Embedding configuration
EMBEDDING_MODE=local
RAG_WARM_INDEX=0

# Gemini model. Use a stable model rather than the mutable latest alias.
GEMINI_MODEL=gemini-2.5-flash

# Gemini generation config
GEMINI_TEMPERATURE=0.2
GEMINI_MAX_OUTPUT_TOKENS=2048
GEMINI_TIMEOUT_MS=90000
GEMINI_MAX_ATTEMPTS=3
GEMINI_STREAM_MAX_ATTEMPTS=2

# ----- Frontend (Vite) -----
# These are consumed at build time and must be prefixed with VITE_
VITE_RAG_API_URL=
VITE_API_URL=

# SSE stream timeout in milliseconds. Should be longer than the backend Gemini timeout.
VITE_RAG_STREAM_TIMEOUT_MS=120000
