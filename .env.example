# ===========================================
# Vachana Sanchaya - Environment Variables
# ===========================================
# Copy this file to .env and fill in the values.
#   cp .env.example .env
# ===========================================

# ----- Required -----

# Google Gemini API Key (required for AI Agent / RAG assistant)
# Get one at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ----- Optional -----

# Node environment (set automatically by Render to "production")
NODE_ENV=development

# Server port (Render sets this automatically; default: 3001)
PORT=3001

# RAG / Embedding configuration
# Mode: "local" (default for production), "ollama", or "openai"
# "local" uses @xenova/transformers (works out-of-the-box)
# "ollama" requires Ollama running locally
# "openai" requires OPENAI_API_KEY
EMBEDDING_MODE=local

# Set to "1" to warm up the RAG index at startup
RAG_WARM_INDEX=0

# Gemini model (default: models/gemini-flash-latest)
GEMINI_MODEL=models/gemini-flash-latest

# Gemini generation config
GEMINI_TEMPERATURE=0.2
GEMINI_MAX_OUTPUT_TOKENS=1024
GEMINI_TIMEOUT_MS=20000

# ----- Frontend (Vite) -----
# These are consumed at build time and must be prefixed with VITE_

# Optional: Override the RAG API base URL
# In development, leave empty to use same-origin (Vite dev server proxy)
# In production, leave empty since Express serves both frontend and API
# Set only if backend is on a different origin
VITE_RAG_API_URL=

# Optional: Override the general API base URL (for author/dataset updates)
# Leave empty to use same-origin (default)
VITE_API_URL=

# Optional: SSE stream timeout in milliseconds (default: 30000)
VITE_RAG_STREAM_TIMEOUT_MS=30000

